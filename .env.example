# 레시피 추출에 사용할 Anthropic(Claude) API 키. 설정 전까지는 /api/extract-recipe가
# AI_NOT_CONFIGURED 오류를 반환하고 UI/파싱 파이프라인만 동작합니다.
ANTHROPIC_API_KEY=

# 선택 사항 (강력 권장): Recipe Scout 검색 비용 절감용.
#
# ▶ 이것만 넣으면 됩니다. Gemini가 구글 검색까지 직접 해서 답합니다.
#   그라운딩 검색이 하루 1,500건까지 무료라, 그 아래에서는 토큰값만 듭니다
#   (건당 약 $0.028 → 약 $0.004).
#   발급: https://aistudio.google.com/apikey
#   ※ 반드시 결제를 연결한 "유료 티어"로 쓰세요. 무료 티어는 하루 1,000건 제한에
#     입력 데이터가 학습에 사용되어, 앱의 개인정보처리방침과 충돌합니다.
GEMINI_API_KEY=

# 선택: 하루 1,500 검색을 넘길 만큼 커졌을 때만 추가하세요.
# 넣으면 검색이 Gemini 그라운딩 대신 Brave로 넘어갑니다($3~5/1,000 —
# 무료 한도를 넘긴 Gemini 그라운딩의 $35/1,000보다 훨씬 쌈).
# 그 전에는 넣을 이유가 없습니다.
#   발급: https://api-dashboard.search.brave.com/
BRAVE_SEARCH_API_KEY=

# 선택: 그라운딩에 쓸 Gemini 모델. 비워두면 gemini-flash-latest(구글이
# 계속 최신 버전으로 바꿔주는 별칭)를 씁니다. 특정 버전을 코드에 박아두면
# 몇 달 뒤 "신규 사용자에게 더 이상 제공되지 않는 모델"로 막히는 걸 이미
# 한 번 겪었어요(2026-07) — 그때처럼 alias 자체가 문제가 되면, 코드 수정 없이
# 여기에 유효한 모델명(예: gemini-flash-latest, gemini-3.6-flash)을 넣고
# 재배포만 하면 즉시 고칠 수 있습니다.
GEMINI_SEARCH_MODEL=

# 선택 사항: 인스타그램 게시물 캡션을 가져오려면 Meta Graph API oEmbed 접근 토큰이 필요합니다.
# 없으면 인스타그램 링크는 "스크린샷을 업로드해 주세요" 안내로 대체됩니다.
INSTAGRAM_OEMBED_TOKEN=

# 아래 Supabase 변수를 모두 설정하기 전까지는 로그인/사용량 제한/결제 기능이 전부
# 비활성화되고, 지금처럼 로그인 없이 무제한으로 사용할 수 있습니다.
# Supabase 프로젝트 생성: https://supabase.com/dashboard → New Project
# Project Settings → API 에서 아래 값을 확인할 수 있습니다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role 키 (공개 금지! 서버에서만 사용)
SUPABASE_SERVICE_ROLE_KEY=

# 위 Supabase 설정 후, supabase/schema.sql 내용을 Supabase 대시보드의
# SQL Editor에 붙여넣고 한 번 실행해서 테이블/함수를 만들어야 합니다.

# 커스텀 도메인을 연결한 뒤 설정하세요 (예: https://avocato.app). SEO/OG 태그와
# sitemap.xml, robots.txt에 사용됩니다. 비워두면 임시 기본값(https://avocato.app)이 쓰입니다.
NEXT_PUBLIC_SITE_URL=

# 관리자 이메일 (쉼표로 여러 명 가능, 예: you@example.com,cofounder@example.com).
# /admin 대시보드 접근 권한 + 무료 횟수/결제 제한 없이 무제한 사용 가능해집니다.
ADMIN_EMAILS=

# 관리자 계정에 비밀번호를 설정할 때(POST /api/admin/set-password) 필요한 공유 비밀값.
# 아무 긴 임의 문자열이나 넣으세요. 설정 후 매직링크 이메일 없이 이메일+비밀번호로 로그인 가능해집니다.
ADMIN_SETUP_SECRET=

# iOS 앱 안에서 Pro 구독을 애플 인앱결제(IAP)로 판매하기 위한 설정. 자세한 절차는
# docs/ios-storekit-setup.md 참고. Avocato는 결제를 애플 IAP로만 처리합니다 —
# 웹에는 결제 수단이 없고(Pro 기능은 iOS 앱에서만 구매 가능), 아래를 다 채우기
# 전까지는 앱에서도 Pro 구매가 비활성화됩니다.
APPLE_BUNDLE_ID=app.avocato.ios
# App Store Connect에서 만든 구독 상품의 Product ID (예: app.avocato.ios.pro.monthly)
APPLE_PRO_PRODUCT_ID=
# 위와 완전히 같은 값. 클라이언트(iOS 앱)에서 구매를 시작할 때도 필요해서 공개 변수로 한 번 더 둡니다.
NEXT_PUBLIC_APPLE_PRO_PRODUCT_ID=
# 앱이 실제로 스토어에 올라간 뒤에만 필요 (App Store Connect → App Information의 Apple ID 숫자).
# 샌드박스/심사 단계에서는 비워둬도 됩니다.
APPLE_APP_APPLE_ID=
# Sandbox | Production — 실제 출시 전까지는 Sandbox로 두세요.
APPLE_IAP_ENVIRONMENT=Sandbox
