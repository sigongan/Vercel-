# 레시피 추출에 사용할 Anthropic(Claude) API 키. 설정 전까지는 /api/extract-recipe가
# AI_NOT_CONFIGURED 오류를 반환하고 UI/파싱 파이프라인만 동작합니다.
ANTHROPIC_API_KEY=

# 선택 사항: 인스타그램 게시물 캡션을 가져오려면 Meta Graph API oEmbed 접근 토큰이 필요합니다.
# 없으면 인스타그램 링크는 "스크린샷을 업로드해 주세요" 안내로 대체됩니다.
INSTAGRAM_OEMBED_TOKEN=

# 아래 Supabase 변수를 모두 설정하기 전까지는 로그인/사용량 제한/결제 기능이 전부
# 비활성화되고, 지금처럼 로그인 없이 무제한으로 사용할 수 있습니다.
# Supabase 프로젝트 생성: https://supabase.com/dashboard → New Project
# Project Settings → API 에서 아래 값을 확인할 수 있습니다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role 키 (공개 금지! 서버에서만 사용)
SUPABASE_SERVICE_ROLE_KEY=

# 위 Supabase 설정 후, supabase/schema.sql 내용을 Supabase 대시보드의
# SQL Editor에 붙여넣고 한 번 실행해서 테이블/함수를 만들어야 합니다.

# 결제(크레딧 구매)를 활성화하려면 Stripe 키도 필요합니다. 둘 다 없으면
# 로그인/무료 한도 기능은 정상 동작하되 "크레딧 구매" 버튼만 비활성화됩니다.
# Stripe 대시보드: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Stripe 웹훅 설정: https://dashboard.stripe.com/webhooks → Add endpoint
# URL: https://<your-domain>/api/stripe/webhook, 이벤트: checkout.session.completed
STRIPE_WEBHOOK_SECRET=
